---
import { siteConfig } from '../config/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: '我的空间' },
  { href: '/blogs', label: '日志' },
  { href: '/blogs?category=notes', label: '技术笔记' },
  { href: '/picture', label: '相册' },
  { href: '/music', label: '音乐盒' },
  { href: '/tools', label: '工具箱' },
  { href: '/link', label: '友情链接' },
];

const isActive = (href: string) => href === '/' ? pathname === '/' : href.includes('?') ? false : pathname.startsWith(href);
---

<div class="nav-wrap">
  <nav class="nav container" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${siteConfig.siteName} 首页`}>
      <span class="brand-pixel" aria-hidden="true"></span>
      <span data-site-name>{siteConfig.siteName}</span>
    </a>
    <div class="links">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const updateBlogNavigation = () => {
    if (!window.location.pathname.startsWith('/blogs')) return;
    const requested = new URL(window.location.href).searchParams.get('category');
    const category = requested ?? document.querySelector<HTMLElement>('[data-article-category]')?.dataset.articleCategory ?? 'journal';
    document.querySelectorAll<HTMLAnchorElement>('.nav .links a[href^="/blogs"]').forEach((link) => {
      const active = category !== 'all' && (new URL(link.href).searchParams.get('category') ?? 'journal') === category;
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };
  updateBlogNavigation();
  document.addEventListener('astro:page-load', updateBlogNavigation);
  window.addEventListener('popstate', updateBlogNavigation);
  window.addEventListener('blog:category-change', updateBlogNavigation);
</script>

<style>
  .nav-wrap { position: relative; z-index: 10; padding-top: 18px; }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 48px;
    padding: 7px 9px 7px 16px;
    background: linear-gradient(#fffaf2, #f9e9e8);
    border: 1px solid #d4acba;
    border-radius: 4px;
    box-shadow: inset 0 1px #fff, 3px 3px 0 #e0c2c9;
  }
  .brand { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; min-width: 0; font-size: 13px; font-weight: 700; }
  .brand > [data-site-name] { overflow-wrap: anywhere; }
  .brand-pixel {
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    margin: 6px;
    background: #c77d9a;
    box-shadow: -4px 0 #e3a5bb, 4px 0 #e3a5bb, 0 -4px #e3a5bb, 0 4px #e3a5bb, -4px -4px #f4d398, 4px 4px #f4d398;
  }
  .links { display: flex; align-items: center; flex: 0 0 auto; gap: 5px; }
  .links a {
    padding: 5px 10px;
    color: var(--text);
    background: linear-gradient(#fffdf8, #f6e8e3);
    border: 1px solid #d9b7c3;
    border-radius: 3px;
    box-shadow: inset 1px 1px #fff, 0 1px 0 #d5b2bf;
    font-size: 12px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .links a:hover { color: #88435f; background: #f9e0e9; border-color: #c5859f; }
  .links a[aria-current='page'] { color: #84435e; background: #f5dce6; border-color: #c5859f; box-shadow: inset 1px 1px 0 #e3b8c9; }
  .links a:active { transform: translateY(1px); box-shadow: inset 1px 1px 2px #cdaab7; }
  @media (max-width: 850px) {
    .nav { flex-direction: column; align-items: stretch; gap: 8px; padding: 10px; }
    .brand { align-self: flex-start; }
    .links { justify-content: space-between; gap: 4px; }
    .links a { flex: 1; padding: 5px 6px; text-align: center; }
  }
  @media (max-width: 480px) {
    .nav-wrap { padding-top: 12px; }
    .links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .links a { font-size: 11px; }
  }
</style>
