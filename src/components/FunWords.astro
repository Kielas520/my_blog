<section class="fun-words" data-fun-words data-source="/fun_words/words.json" aria-label="随机名言">
  <div class="fun-window">
    <p class="fun-text" data-fun-text data-align="center" data-motion="fade">正在接收来自互联网的句子…</p>
  </div>
</section>

<script>
  const stage = document.querySelector('[data-fun-words]');
  const textNode = stage?.querySelector('[data-fun-text]');

  if (stage instanceof HTMLElement && textNode instanceof HTMLElement) {
    type WordEntry = {
      text: string;
      align?: 'left' | 'center' | 'right' | 'random';
      motion?: 'fade' | 'up' | 'left' | 'right' | 'random';
    };
    type WordsPayload = { words?: Array<string | WordEntry>; interval?: number };

    const source = stage.dataset.source ?? '/fun_words/words.json';
    const fallback = [
      '深夜的海边，浪声没停过，但你不觉得吵…',
      'Definition → NuLL',
      '互联网是一片有潮汐的海。',
    ];
    const alignments = ['left', 'center', 'right'];
    const motions = ['fade', 'up', 'left', 'right'];
    const pick = <T,>(values: T[]) => values[Math.floor(Math.random() * values.length)];
    const normalize = (entry: string | WordEntry): WordEntry => typeof entry === 'string' ? { text: entry } : entry;
    const shuffle = <T,>(values: T[]) => {
      for (let index = values.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [values[index], values[randomIndex]] = [values[randomIndex], values[index]];
      }
      return values;
    };

    const run = (entries: Array<string | WordEntry>, interval?: number) => {
      const words = entries.map(normalize).filter((entry) => entry?.text);
      if (!words.length) words.push(...fallback.map((text) => ({ text })));
      const duration = Math.max(Number(interval) || 6500, 3200);
      stage.style.setProperty('--word-duration', `${duration}ms`);
      let queue: WordEntry[] = [];
      let previousText = '';

      const refillQueue = () => {
        queue = shuffle([...words]);
        if (queue.length > 1 && queue[0].text === previousText) {
          [queue[0], queue[1]] = [queue[1], queue[0]];
        }
      };

      const showNext = () => {
        if (!queue.length) refillQueue();
        const entry = queue.shift();
        if (!entry) return;
        previousText = entry.text;
        textNode.className = 'fun-text';
        void textNode.offsetWidth;
        textNode.textContent = entry.text;
        textNode.dataset.align = entry.align && entry.align !== 'random' ? entry.align : pick(alignments);
        textNode.dataset.motion = entry.motion && entry.motion !== 'random' ? entry.motion : pick(motions);
      };

      showNext();
      window.setInterval(showNext, duration);
    };

    fetch(`${source}?v=${Date.now()}`, { cache: 'no-store' })
      .then((response) => response.ok ? response.json() as Promise<WordsPayload | Array<string | WordEntry>> : Promise.reject(new Error('words file unavailable')))
      .then((data) => {
        const payload: WordsPayload = Array.isArray(data) ? { words: data } : data;
        run(payload.words ?? fallback, payload.interval);
      })
      .catch(() => run(fallback, 6500));
  }
</script>

<style>
  .fun-words { --word-duration: 6500ms; margin-top: 96px; }
  .fun-window {
    position: relative;
    display: grid;
    min-height: 250px;
    overflow: hidden;
    padding: clamp(48px, 7vw, 90px);
    align-items: center;
    background:
      radial-gradient(ellipse at 50% 18%, rgba(255,255,255,.62), transparent 58%),
      rgba(225,247,255,.42);
    border: 1px solid rgba(255,255,255,.52);
    border-radius: 38px;
    box-shadow: inset 0 1px rgba(255,255,255,.74), 0 16px 42px rgba(30,112,145,.09);
    backdrop-filter: blur(14px) saturate(1.25);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 0 67%, rgba(0,0,0,.92) 78%, transparent 100%);
    mask-image: radial-gradient(ellipse at center, #000 0 67%, rgba(0,0,0,.92) 78%, transparent 100%);
  }
  .fun-text { width: 100%; margin: 0; color: #245368; font: 400 clamp(1.15rem, 2.8vw, 2rem)/1.6 Georgia, "Times New Roman", serif; text-shadow: 0 1px rgba(255,255,255,.9); animation-duration: var(--word-duration); animation-timing-function: ease-in-out; animation-fill-mode: both; }
  .fun-text[data-align='left'] { margin-right: auto; text-align: left; }
  .fun-text[data-align='center'] { margin-inline: auto; text-align: center; }
  .fun-text[data-align='right'] { margin-left: auto; text-align: right; }
  .fun-text[data-motion='fade'] { animation-name: word-fade; }
  .fun-text[data-motion='up'] { animation-name: word-up; }
  .fun-text[data-motion='left'] { animation-name: word-left; }
  .fun-text[data-motion='right'] { animation-name: word-right; }
  @keyframes word-fade { 0%,100% { opacity: .28; } 7%,93% { opacity: 1; } }
  @keyframes word-up { 0% { opacity: .28; transform: translateY(22px); } 7%,93% { opacity: 1; transform: translateY(0); } 100% { opacity: .28; transform: translateY(-22px); } }
  @keyframes word-left { 0% { opacity: .28; transform: translateX(38px); } 7%,93% { opacity: 1; transform: translateX(0); } 100% { opacity: .28; transform: translateX(-42px); } }
  @keyframes word-right { 0% { opacity: .28; transform: translateX(-38px); } 7%,93% { opacity: 1; transform: translateX(0); } 100% { opacity: .28; transform: translateX(42px); } }
  @media (prefers-reduced-motion: reduce) { .fun-text { animation-name: word-fade !important; } }
  @media (max-width: 600px) {
    .fun-words { margin-top: 68px; }
    .fun-window { min-height: 210px; padding: 48px 34px; border-radius: 30px; }
  }
</style>
