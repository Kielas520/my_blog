---
const bubbles = Array.from({ length: 22 });
---

<div class="ambient-bubbles" aria-hidden="true">
  {bubbles.map(() => <span></span>)}
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.ambient-bubbles span').forEach((bubble, index) => {
    const random = (min: number, max: number) => Math.random() * (max - min) + min;
    const size = random(24, 126);
    const colors = ['87, 201, 255', '121, 229, 88', '255, 126, 193', '255, 210, 77', '142, 117, 255', '66, 224, 207'];

    bubble.style.setProperty('--size', `${size}px`);
    bubble.style.setProperty('--bubble-color', colors[index % colors.length]);
    bubble.style.setProperty('--bubble-opacity', random(.18, .42).toFixed(2));
    bubble.style.left = `${random(-6, 96)}vw`;
    bubble.style.top = `${random(-8, 98)}vh`;

    if (reduceMotion) return;

    const x = random(45, 180) * (Math.random() > .5 ? 1 : -1);
    const y = random(55, 210) * (Math.random() > .5 ? 1 : -1);
    const spin = random(20, 150) * (Math.random() > .5 ? 1 : -1);
    bubble.animate([
      { transform: 'translate3d(0, 0, 0) scale(1)' },
      { transform: `translate3d(${x * .45}px, ${-y * .28}px, 0) scale(${random(.86, 1.12)})` },
      { transform: `translate3d(${-x * .35}px, ${y * .5}px, 0) scale(${random(.9, 1.18)})` },
      { transform: `translate3d(${x}px, ${y * .18}px, 0) scale(${random(.82, 1.08)})` },
      { transform: `translate3d(0, 0, 0) scale(1) rotate(${spin}deg)` },
    ], {
      duration: random(22000, 48000),
      delay: -random(0, 30000),
      iterations: Infinity,
      easing: 'ease-in-out',
    });
  });
</script>

<style>
  .ambient-bubbles {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  span {
    position: absolute;
    width: var(--size);
    height: var(--size);
    opacity: var(--bubble-opacity);
    background:
      radial-gradient(circle at 28% 23%, rgba(255,255,255,.96) 0 4%, rgba(255,255,255,.46) 5% 13%, transparent 24%),
      radial-gradient(circle at 66% 72%, rgba(var(--bubble-color), .62), rgba(var(--bubble-color), .16) 48%, rgba(255,255,255,.14) 68%, rgba(var(--bubble-color), .46) 100%);
    border: 1px solid rgba(255,255,255,.82);
    border-radius: 50%;
    box-shadow:
      inset 7px 8px 18px rgba(255,255,255,.62),
      inset -8px -9px 18px rgba(var(--bubble-color), .22),
      0 8px 22px rgba(25,102,142,.14),
      0 0 3px rgba(255,255,255,.9);
    backdrop-filter: blur(1.5px) saturate(1.35);
    will-change: transform;
  }

  @media (max-width: 600px) {
    span:nth-child(n + 15) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    span { opacity: .13; }
  }
</style>
