---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blogs'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categoryName = {
  'dairy': 'dairy',
  'thoughts': 'Thoughts',
  'ticktick': 'TICKTICK',
  'get-a-job': 'getAjob',
} as const;

const categoryKeys = [...new Set(posts.map((post) => post.data.category))];
const getCategoryName = (category: string) => categoryName[category as keyof typeof categoryName] ?? category;
const categories = categoryKeys
  .map((key) => ({
    key,
    label: getCategoryName(key),
    count: posts.filter((post) => post.data.category === key).length,
  }))
  .sort((a, b) => b.count - a.count);

const defaultCategory = categories[0]?.key;
---

<BaseLayout title="Blogs" description="Kielasovo 的文章与随笔。">
  <header class="container page-head">
    <p class="eyebrow">Personal archive</p>
    <h1>Blogs</h1>
  </header>
  <div class="container categories" aria-label="按分类筛选文章">
    {categories.map(({ key, label, count }) => (
      <button
        type="button"
        class:list={{ active: key === defaultCategory }}
        data-category={key}
        aria-pressed={key === defaultCategory ? 'true' : 'false'}
        aria-controls="blog-posts"
      >
        <i>{count}</i>{label}
      </button>
    ))}
  </div>
  <section class="container posts" id="blog-posts" aria-label="文章列表" aria-live="polite">
    {posts.length === 0 ? (
      <div class="empty-state"><strong>SELECTED BLOGS / SOON</strong><p>等待第一批精选文章进入这里。</p></div>
    ) : posts.map((post) => (
      <article data-post-category={post.data.category} hidden={post.data.category !== defaultCategory}>
        <a href={`/blogs/${post.id}`}>
          <div class="meta"><span>{getCategoryName(post.data.category)}</span><time>{post.data.publishedAt.toLocaleDateString('zh-CN')}</time></div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>
          <span class="arrow">READ ›</span>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<script>
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('[data-category]');
  const postCards = document.querySelectorAll<HTMLElement>('[data-post-category]');

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory = button.dataset.category;

      categoryButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      postCards.forEach((card) => {
        card.hidden = card.dataset.postCategory !== selectedCategory;
      });
    });
  });
</script>

<style>
  .categories { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 25px; }
  .categories button { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; color: #527486; background: rgba(255,255,255,.55); border: 1px solid rgba(255,255,255,.9); border-radius: 9px; box-shadow: 0 3px 8px rgba(45,111,139,.08); font: 700 .6rem/1 Verdana, sans-serif; cursor: pointer; transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease; }
  .categories button:hover { transform: translateY(-1px); background: rgba(255,255,255,.82); }
  .categories button:focus-visible { outline: 2px solid #277d9f; outline-offset: 2px; }
  .categories button.active { color: #174f67; background: rgba(221,247,255,.92); border-color: rgba(70,153,185,.55); }
  .categories i { display: grid; width: 18px; height: 18px; color: #fff; background: #66aa4b; border-radius: 50%; place-items: center; font-style: normal; }
  .categories button.active i { background: #277d9f; }
  .posts { display: grid; grid-template-columns: repeat(2, 1fr); overflow: hidden; background: rgba(255,255,255,.38); border: 1px solid rgba(255,255,255,.9); border-radius: 22px; box-shadow: 0 16px 35px rgba(43,109,137,.11); }
  article[hidden] { display: none; }
  article { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  article a { position: relative; display: block; min-height: 310px; padding: 30px; transition: background 180ms ease; }
  article a:hover { background: rgba(255,255,255,.55); }
  .meta { display: flex; justify-content: space-between; color: var(--muted); font: .65rem/1 ui-monospace, monospace; }
  .meta > span { color: var(--green-dark); }
  h2 { max-width: 450px; margin: 48px 0 10px; color: #184b64; font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.15; letter-spacing: -.04em; }
  article p { max-width: 440px; margin: 0; color: var(--muted); font-size: .8rem; }
  .tags { display: flex; gap: 9px; margin-top: 18px; color: #6f929e; font: .65rem/1 ui-monospace, monospace; }
  .arrow { position: absolute; right: 28px; bottom: 25px; color: #277d9f; font: 700 .6rem/1 Verdana, sans-serif; }
  .empty-state { grid-column: 1 / -1; padding: 78px 30px; }
  .empty-state strong { color: #2c708d; font: 800 .75rem/1 Verdana, sans-serif; letter-spacing: .1em; }
  .empty-state p { margin: 12px 0 0; }
  @media (max-width: 720px) { .posts { grid-template-columns: 1fr; } article a { min-height: 270px; } }
</style>
