---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blogs'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categoryName = { journal: '日志', notes: '技术笔记' } as const;
const categories = [
  ...Object.entries(categoryName).map(([key, label]) => ({ key, label, count: posts.filter((post) => post.data.category === key).length })),
  { key: 'all', label: '全部', count: posts.length },
];
const months = new Map<string, typeof posts>();
for (const post of posts) {
  const month = post.data.publishedAt.toISOString().slice(0, 7);
  const group = months.get(month) ?? [];
  group.push(post);
  months.set(month, group);
}
---

<BaseLayout title="日志与技术笔记" description="日志、技术笔记与文章归档。">
  <div class="container blog-archive">
    <header class="archive-head">
      <h1>日志与技术笔记</h1>
    </header>
    <nav class="categories" aria-label="按分类浏览文章">
      {categories.map(({ key, label, count }) => (
        <a href={key === 'journal' ? '/blogs' : `/blogs?category=${key}`} data-category={key} aria-controls="blog-posts">
          {label}<span>{count}</span>
        </a>
      ))}
    </nav>
    <noscript><p class="archive-hint">以下列出全部文章，可直接打开日志或技术笔记。</p></noscript>
    <div id="blog-posts" aria-label="文章列表">
      {[...months].map(([month, monthPosts]) => (
        <section class="month-group" data-month-group aria-labelledby={`month-${month}`}>
          <h2 class="month-title" id={`month-${month}`}>{`${month.slice(0, 4)} 年 ${Number(month.slice(5))} 月`}</h2>
          <ol class="post-list">
            {monthPosts.map((post) => (
              <li data-post-category={post.data.category}>
                <article>
                  <a class="post-link" href={`/blogs/${post.id}?category=${post.data.category}`}>
                    <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{post.data.publishedAt.toISOString().slice(5, 10).replace('-', ' / ')}</time>
                    <div class="post-copy">
                      <h3 class="post-title">{post.data.title}</h3>
                      <p>{post.data.description}</p>
                      <span class="post-category">{categoryName[post.data.category]}</span>
                    </div>
                    <span class="post-arrow" aria-hidden="true">›</span>
                  </a>
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
    <p class="empty-state" data-empty-state hidden={posts.length !== 0}>这个分类还没有文章。</p>
  </div>
</BaseLayout>

<script>
  const updateBlogCategory = () => {
    const archive = document.querySelector<HTMLElement>('.blog-archive');
    if (!archive) return;
    const requested = new URL(window.location.href).searchParams.get('category');
    const category = requested === 'notes' || requested === 'all' ? requested : 'journal';
    archive.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((link) => {
      const active = link.dataset.category === category;
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    let visiblePosts = 0;
    archive.querySelectorAll<HTMLElement>('[data-month-group]').forEach((group) => {
      let visibleInMonth = 0;
      group.querySelectorAll<HTMLElement>('[data-post-category]').forEach((item) => {
        item.hidden = category !== 'all' && item.dataset.postCategory !== category;
        if (!item.hidden) visibleInMonth += 1;
        const link = item.querySelector<HTMLAnchorElement>('.post-link');
        if (link) {
          const url = new URL(link.href);
          url.searchParams.set('category', category);
          link.href = `${url.pathname}${url.search}`;
        }
      });
      group.hidden = visibleInMonth === 0;
      visiblePosts += visibleInMonth;
    });
    const empty = archive.querySelector<HTMLElement>('[data-empty-state]');
    if (empty) empty.hidden = visiblePosts !== 0;
  };

  const bindBlogCategories = () => {
    const categoryBar = document.querySelector<HTMLElement>('.blog-archive .categories');
    if (!categoryBar) return;
    updateBlogCategory();
    if (categoryBar.dataset.bound === 'true') return;
    categoryBar.dataset.bound = 'true';
    categoryBar.addEventListener('click', (event) => {
      if (!(event instanceof MouseEvent) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-category]');
      if (!link || !categoryBar.contains(link)) return;
      event.preventDefault();
      if (window.location.href !== link.href) window.history.pushState(null, '', link.href);
      updateBlogCategory();
      window.dispatchEvent(new Event('blog:category-change'));
    });
  };

  window.addEventListener('popstate', updateBlogCategory);
  document.addEventListener('astro:page-load', bindBlogCategories);
  bindBlogCategories();
</script>

<style>
  .blog-archive { max-width: 840px; padding-block: 30px 48px; }
  .archive-head { margin-bottom: 20px; }
  .archive-head h1 { margin: 0; color: var(--text); font-size: clamp(1.45rem, 3vw, 1.9rem); line-height: 1.45; }
  .archive-hint { margin: 9px 0 0; color: var(--muted); font-size: .85rem; }
  .categories { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 28px; }
  .categories a { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; color: var(--text); background: linear-gradient(#fffdf8, #f4e2df); border: 1px solid #cdaab7; border-radius: 3px; box-shadow: inset 1px 1px #fff, 1px 2px #ddbdc6; font-size: .8rem; }
  .categories a:hover, .categories a.active { color: #7e3f58; background: #f4dce5; border-color: var(--accent); }
  .categories span { color: var(--muted); font-size: .7rem; }
  .month-group { margin-bottom: 25px; }
  .month-title { margin: 0 0 9px; color: var(--muted); font-size: .85rem; font-weight: 600; line-height: 1.6; }
  .post-list { margin: 0; padding: 0; list-style: none; background: var(--surface); border: 1px solid var(--line); box-shadow: 2px 2px #e8cfd1; }
  .post-list li + li { border-top: 1px dotted var(--line); }
  .post-link { display: grid; grid-template-columns: 58px minmax(0, 1fr) 12px; gap: 16px; align-items: start; padding: 15px 18px; }
  .post-link:hover { background: #fff0f2; }
  time { padding-top: 3px; color: var(--muted); font: .7rem/1.7 ui-monospace, monospace; white-space: nowrap; }
  .post-copy { min-width: 0; }
  .post-title { margin: 0; color: var(--text); font-size: 1rem; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
  .post-copy p { margin: 5px 0; color: var(--muted); font-size: .8rem; line-height: 1.7; overflow-wrap: anywhere; }
  .post-category { color: #a0788b; font-size: .68rem; }
  .post-arrow { color: var(--accent); }
  [hidden] { display: none; }
  @media (max-width: 580px) {
    .blog-archive { padding-top: 24px; }
    .post-link { grid-template-columns: 47px minmax(0, 1fr); gap: 10px; padding: 13px 12px; }
    time { font-size: .65rem; }
    .post-arrow { display: none; }
  }
</style>
