---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Post = CollectionEntry<'blogs'>;

export async function getStaticPaths() {
  const posts = (await getCollection('blogs'))
    .filter((post) => !post.data.draft) as Post[];

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const categoryName = {
  'dairy': 'dairy',
  'thoughts': 'Thoughts',
  'ticktick': 'TICKTICK',
  'get-a-job': 'getAjob',
}[post.data.category];
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container article">
    <a class="back" href="/blogs">← 返回文章</a>
    <header>
      <p class="eyebrow">{categoryName}</p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span>{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .article { max-width: 820px; padding-top: 60px; }
  .back { color: var(--muted); font-size: .82rem; }
  header { padding: 90px 0 48px; border-bottom: 1px solid var(--line); }
  h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 5.4rem); line-height: 1.02; letter-spacing: -.065em; }
  .description { max-width: 610px; margin: 24px 0 0; color: var(--muted); font-size: 1.08rem; }
  .meta { display: flex; justify-content: space-between; gap: 20px; margin-top: 36px; color: #6c726e; font: .7rem/1.5 ui-monospace, monospace; }
  .prose { padding: 50px 0; font-size: 1.04rem; }
  .prose :global(h2) { margin: 2.4em 0 .7em; font-size: 1.8rem; letter-spacing: -.04em; }
  .prose :global(h3) { margin-top: 2em; }
  .prose :global(p), .prose :global(li) { color: #c2c6c1; }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid rgba(184,243,90,.35); }
  .prose :global(code) { padding: .15em .4em; color: var(--accent); background: var(--surface-raised); border-radius: 5px; font-size: .9em; }
  .prose :global(pre) { overflow: auto; padding: 22px; background: #050606; border: 1px solid var(--line); border-radius: 12px; }
  .prose :global(pre code) { padding: 0; color: inherit; background: none; }
  .prose :global(blockquote) { margin: 2em 0; padding-left: 20px; color: var(--muted); border-left: 2px solid var(--accent); }
  @media (max-width: 580px) { header { padding-top: 65px; } .meta { flex-direction: column; } }
</style>
