---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Post = CollectionEntry<'blogs'>;

export async function getStaticPaths() {
  const posts = (await getCollection('blogs'))
    .filter((post) => !post.data.draft) as Post[];

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const categoryName = { journal: '日志', notes: '技术笔记' }[post.data.category];
const backUrl = post.data.category === 'notes' ? '/blogs?category=notes' : '/blogs';
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container article" data-article-category={post.data.category}>
    <a class="back" data-blog-back href={backUrl}>← 返回{categoryName}</a>
    <header>
      <p class="eyebrow">{categoryName}</p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
        <span>{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
      </div>
    </header>
    {outline.length > 0 && (
      <details class="article-outline">
        <summary>文章目录</summary>
        <ol>
          {outline.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </details>
    )}
    <div class="prose" data-prose><Content /></div>
  </article>
</BaseLayout>

<script>
  const updateBlogBackLink = () => {
    const back = document.querySelector<HTMLAnchorElement>('[data-blog-back]');
    if (!back) return;
    const category = new URL(window.location.href).searchParams.get('category');
    if (category !== 'journal' && category !== 'notes' && category !== 'all') return;
    back.href = category === 'journal' ? '/blogs' : `/blogs?category=${category}`;
    back.textContent = `← 返回${category === 'notes' ? '技术笔记' : category === 'all' ? '全部文章' : '日志'}`;
  };
  document.addEventListener('astro:page-load', updateBlogBackLink);
  updateBlogBackLink();

  const appendNotionText = (fragment: DocumentFragment, nodes: Node[]) => {
    let paragraph = document.createElement('p');

    const flush = () => {
      if (paragraph.textContent?.trim() || paragraph.children.length) fragment.append(paragraph);
      paragraph = document.createElement('p');
    };

    nodes.forEach((node) => {
      if (node.nodeType === Node.TEXT_NODE) {
        const lines = (node.textContent ?? '').split(/\r?\n/);
        lines.forEach((line, index) => {
          if (line.trim()) paragraph.append(document.createTextNode(line.trim()));
          if (index < lines.length - 1) flush();
        });
        return;
      }
      if (node instanceof HTMLBRElement) {
        flush();
        return;
      }
      if (node instanceof HTMLElement && node.tagName === 'EMPTY-BLOCK') return;
      paragraph.append(node);
    });
    flush();
  };

  const repairNotionContainers = (prose: HTMLElement) => {
    const mixedContainers = Array.from(prose.querySelectorAll<HTMLElement>('h2, p')).filter((container) =>
      Array.from(container.children).some((child) => child.tagName === 'COLUMNS')
    );

    mixedContainers.forEach((container) => {
      const fragment = document.createDocumentFragment();
      let bufferedNodes: Node[] = [];
      const flush = () => {
        appendNotionText(fragment, bufferedNodes);
        bufferedNodes = [];
      };

      Array.from(container.childNodes).forEach((node) => {
        if (node instanceof HTMLElement && node.tagName === 'COLUMNS') {
          flush();
          fragment.append(node);
        } else {
          bufferedNodes.push(node);
        }
      });
      flush();

      // A Notion divider (`---`) immediately after raw <columns> is parsed by
      // CommonMark as a Setext h2 underline. Restore the intended divider.
      if (container.tagName === 'H2') fragment.append(document.createElement('hr'));
      container.replaceWith(fragment);
    });

    prose.querySelectorAll('empty-block').forEach((block) => block.remove());
  };

  const enhanceImageGallery = (gallery: HTMLElement) => {
    const blocks = Array.from(gallery.children).filter((element): element is HTMLParagraphElement => element.tagName === 'P');
    const images = blocks.map((block) => block.querySelector<HTMLImageElement>('img')).filter((image): image is HTMLImageElement => Boolean(image));
    if (images.length !== blocks.length) return;

    const applyLayout = () => {
      if (gallery.dataset.layoutApplied === 'true') return;
      if (images.some((image) => !image.naturalWidth || !image.naturalHeight)) return;
      gallery.dataset.layoutApplied = 'true';
      const ratios = images.map((image) => image.naturalWidth / image.naturalHeight);
      gallery.replaceChildren();

      const createRow = (kind: 'pair' | 'mosaic' | 'solo' | 'wide') => {
        const row = document.createElement('div');
        row.className = `gallery-row gallery-${kind}`;
        gallery.append(row);
        return row;
      };

      let index = 0;
      while (index < blocks.length) {
        const remaining = blocks.length - index;
        const ratio = ratios[index];

        if (ratio >= 2.2) {
          createRow('wide').append(blocks[index]);
          index += 1;
          continue;
        }

        if (remaining >= 3 && ratio < .9 && ratios[index + 1] >= 1 && ratios[index + 1] < 2.2 && ratios[index + 2] >= 1 && ratios[index + 2] < 2.2) {
          const row = createRow('mosaic');
          blocks[index].classList.add('gallery-feature');
          row.append(blocks[index]);
          const stack = document.createElement('div');
          stack.className = 'gallery-stack';
          stack.append(blocks[index + 1], blocks[index + 2]);
          row.append(stack);
          index += 3;
          continue;
        }

        if (remaining >= 2 && ratios[index + 1] < 2.2) {
          const row = createRow('pair');
          row.append(blocks[index], blocks[index + 1]);
          index += 2;
          continue;
        }

        createRow('solo').append(blocks[index]);
        index += 1;
      }
      gallery.classList.add('gallery-ready');
    };

    images.forEach((image) => {
      if (!image.complete) image.addEventListener('load', applyLayout, { once: true });
    });
    applyLayout();
  };

  const arrangeNotionColumns = (prose: HTMLElement) => {
    prose.querySelectorAll<HTMLElement>('columns').forEach((container) => {
      const columns = Array.from(container.children).filter((column): column is HTMLElement => column.tagName === 'COLUMN');
      if (!columns.length) {
        container.remove();
        return;
      }

      const images = columns.map((column) => {
        const matches = column.querySelectorAll<HTMLImageElement>('img');
        return matches.length === 1 && !column.textContent?.trim() ? matches[0] : null;
      });

      if (images.every((image): image is HTMLImageElement => Boolean(image))) {
        const gallery = document.createElement('div');
        gallery.className = 'image-gallery notion-image-gallery';
        gallery.setAttribute('role', 'group');
        gallery.setAttribute('aria-label', 'Notion 图片组');
        images.forEach((image) => {
          const block = document.createElement('p');
          block.append(image);
          gallery.append(block);
        });
        container.replaceWith(gallery);
        enhanceImageGallery(gallery);
        return;
      }

      const ratios = columns.map((column) => Number(column.getAttribute('ratio')) || 1);
      container.classList.add('notion-columns');
      container.style.gridTemplateColumns = ratios.map((ratio) => `minmax(0, ${ratio}fr)`).join(' ');
    });
  };

  const arrangeImageGalleries = () => {
    document.querySelectorAll<HTMLElement>('[data-prose]:not([data-galleries-arranged])').forEach((prose) => {
      prose.dataset.galleriesArranged = 'true';
      repairNotionContainers(prose);
      arrangeNotionColumns(prose);
      const imageBlocks = Array.from(prose.children).filter((element): element is HTMLParagraphElement => {
        if (element.tagName !== 'P') return false;
        const paragraph = element as HTMLParagraphElement;
        return paragraph.children.length === 1 && paragraph.firstElementChild?.tagName === 'IMG';
      });

      let group: HTMLParagraphElement[] = [];
      const flush = () => {
        if (group.length < 2) {
          group = [];
          return;
        }
        const gallery = document.createElement('div');
        gallery.className = 'image-gallery';
        gallery.setAttribute('role', 'group');
        gallery.setAttribute('aria-label', '图片组');
        group[0].before(gallery);
        group.forEach((block) => gallery.append(block));
        enhanceImageGallery(gallery);
        group = [];
      };

      Array.from(prose.children).forEach((element) => {
        if (imageBlocks.includes(element as HTMLParagraphElement)) {
          group.push(element as HTMLParagraphElement);
        } else {
          flush();
        }
      });
      flush();
    });
  };

  document.addEventListener('astro:page-load', arrangeImageGalleries);
  arrangeImageGalleries();
</script>

<style>
  .article { max-width: 900px; padding-top: 28px; }
  .back { color: var(--muted); font-size: .82rem; }
  header { max-width: 740px; margin-inline: auto; padding: 24px 0; border-bottom: 1px solid var(--line); }
  h1 { margin: 0; overflow-wrap: anywhere; color: var(--text); font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.45; }
  .description { margin: 14px 0 0; color: var(--muted); font-size: .95rem; line-height: 1.8; }
  .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; color: var(--muted); font: .75rem/1.5 ui-monospace, monospace; }
  .article-outline { max-width: 740px; margin: 20px auto; padding: 14px 20px; border: 1px dashed var(--line); background: var(--surface); font-size: .85rem; }
  .article-outline summary { cursor: pointer; color: var(--accent); }
  .article-outline ol { padding-left: 20px; line-height: 1.9; }
  .article-outline .nested { margin-left: 16px; }
  .prose { max-width: 740px; margin: 26px auto 64px; padding: 28px 32px; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; box-shadow: 3px 3px 0 #e8cfd1; font-family: system-ui, "Microsoft YaHei", "PingFang SC", sans-serif; font-size: 17px; line-height: 1.9; overflow-wrap: anywhere; }
  .prose :global(h2) { margin: 2em 0 .75em; color: var(--text); font-size: 1.35rem; line-height: 1.5; }
  .prose :global(h3) { margin: 1.8em 0 .65em; color: var(--text); font-size: 1.15rem; line-height: 1.5; }
  .prose :global(h4) { margin: 1.8em 0 .55em; color: var(--text); font-size: 1.05rem; }
  .prose :global(p) { margin: 1em 0; }
  .prose :global(li) { margin: .38em 0; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid var(--line); }
  .prose :global(code) { padding: .15em .4em; color: var(--accent); background: var(--surface-raised); border-radius: 3px; font-size: .9em; }
  .prose :global(pre) { overflow: auto; padding: 20px; background: #302831; border: 1px solid var(--line); border-radius: 4px; }
  .prose :global(pre code) { padding: 0; color: inherit; background: none; }
  .prose :global(blockquote), .prose :global(aside) { display: block; margin: 2em 0; padding: 14px 18px; color: var(--text); background: #f8e8ec; border-left: 3px solid var(--accent); }
  .prose :global(img) { display: block; width: auto; max-width: 100%; max-height: min(72vh, 760px); margin: 2.2rem auto; object-fit: contain; border: 8px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 14px 32px rgba(29,87,111,.18); }
  .prose :global(columns) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: clamp(14px, 2.2vw, 26px); margin: clamp(2.4rem, 5vw, 4rem) 0; }
  .prose :global(column) { display: block; min-width: 0; }
  .prose :global(empty-block) { display: none; }
  .prose :global(.image-gallery) { display: flex; flex-direction: column; gap: clamp(14px, 2.2vw, 26px); margin: clamp(2.4rem, 5vw, 4rem) 0; }
  .prose :global(.gallery-row) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 2.2vw, 26px); align-items: stretch; }
  .prose :global(.gallery-row p) { display: flex; min-width: 0; min-height: clamp(220px, 30vw, 400px); margin: 0; padding: 14px; background: #fff9f1; border: 1px solid var(--line); border-radius: 3px; box-shadow: 2px 2px 0 #e8cfd1; align-items: center; justify-content: center; }
  .prose :global(.image-gallery img) { width: auto; height: auto; max-width: 100%; max-height: min(62vh, 520px); margin: auto; border: 0; border-radius: 10px; box-shadow: 0 8px 18px rgba(29,87,111,.1); object-fit: contain; }
  .prose :global(.gallery-mosaic) { grid-template-rows: repeat(2, minmax(0, 1fr)); }
  .prose :global(.gallery-mosaic > p.gallery-feature) { grid-row: 1 / 3; }
  .prose :global(.gallery-mosaic > .gallery-stack) { grid-row: 1 / 3; }
  .prose :global(.gallery-stack) { display: grid; min-width: 0; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 2.2vw, 26px); }
  .prose :global(.gallery-stack p) { min-height: 0; }
  .prose :global(.gallery-wide), .prose :global(.gallery-solo) { grid-template-columns: 1fr; }
  .prose :global(.gallery-wide p) { min-height: clamp(220px, 24vw, 360px); }
  .prose :global(.gallery-wide img) { max-width: min(100%, 980px); max-height: min(52vh, 420px); }
  .prose :global(.gallery-solo p) { min-height: clamp(300px, 36vw, 520px); }
  .prose :global(.gallery-solo img) { max-width: min(82%, 980px); max-height: min(68vh, 620px); }
  .prose :global(hr) { height: 1px; margin: 2.6rem 0; background: var(--line); border: 0; }
  .prose :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; }
  .prose :global(th), .prose :global(td) { padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
  .prose :global(th) { color: var(--text); background: #f8e8ec; }
  @media (max-width: 580px) {
    .meta { flex-direction: column; }
    .prose { padding: 20px 16px; font-size: 16px; }
    .prose :global(img) { max-height: 68vh; border-width: 5px; }
    .prose :global(columns), .prose :global(.gallery-row), .prose :global(.gallery-stack) { grid-template-columns: 1fr !important; grid-template-rows: none; }
    .prose :global(columns), .prose :global(.image-gallery) { margin: 2rem 0; }
    .prose :global(.gallery-row), .prose :global(.gallery-stack) { gap: 14px; }
    .prose :global(.gallery-row p), .prose :global(.gallery-stack p), .prose :global(.gallery-wide p), .prose :global(.gallery-solo p), .prose :global(.gallery-mosaic > p.gallery-feature) { grid-row: auto; grid-column: auto; min-height: 220px; padding: 12px; }
    .prose :global(.image-gallery img), .prose :global(.gallery-wide img), .prose :global(.gallery-solo img) { max-width: 100%; max-height: 68vh; }
  }
</style>
