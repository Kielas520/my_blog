---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Post = CollectionEntry<'blogs'>;

export async function getStaticPaths() {
  const posts = (await getCollection('blogs'))
    .filter((post) => !post.data.draft) as Post[];

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const titleLength = Array.from(post.data.title).length;
const titleClass = titleLength >= 13 ? 'title-long' : titleLength >= 9 ? 'title-medium' : '';
const categoryName = {
  'dairy': 'dairy',
  'thoughts': 'Thoughts',
  'ticktick': 'TICKTICK',
  'get-a-job': 'getAjob',
}[post.data.category] ?? post.data.category;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container article">
    <a class="back" href="/blogs">← 返回文章</a>
    <header>
      <p class="eyebrow">{categoryName}</p>
      <h1 class={titleClass}>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span>{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .article { max-width: 900px; padding-top: 60px; }
  .back { color: var(--muted); font-size: .82rem; }
  header { padding: 82px 0 44px; border-bottom: 1px solid var(--line); }
  h1 { max-width: 100%; margin: 0; overflow-wrap: anywhere; color: #143f57; font-size: clamp(2.35rem, 6.4vw, 5rem); line-height: 1.05; letter-spacing: -.055em; text-wrap: balance; }
  h1.title-medium { font-size: clamp(2.2rem, 5.6vw, 4.3rem); letter-spacing: -.045em; }
  h1.title-long { font-size: clamp(2rem, 4.8vw, 3.65rem); letter-spacing: -.035em; }
  .description { max-width: 680px; margin: 24px 0 0; color: #46697b; font-size: 1.08rem; line-height: 1.75; text-wrap: pretty; }
  .meta { display: flex; justify-content: space-between; gap: 20px; margin-top: 36px; color: #6c726e; font: .7rem/1.5 ui-monospace, monospace; }
  .prose { margin: 38px 0 64px; padding: clamp(26px, 5vw, 54px); color: #234c62; background: rgba(255,255,255,.64); border: 1px solid rgba(255,255,255,.92); border-radius: 22px; box-shadow: 0 16px 38px rgba(34,103,133,.1); font-family: system-ui, "Microsoft YaHei", "PingFang SC", sans-serif; font-size: clamp(1rem, 1.2vw, 1.08rem); line-height: 1.9; }
  .prose :global(h2) { margin: 2.35em 0 .75em; color: #143f57; font-size: clamp(1.55rem, 3vw, 1.9rem); line-height: 1.3; letter-spacing: -.025em; text-wrap: balance; }
  .prose :global(h3) { margin: 2em 0 .65em; color: #1b5069; font-size: clamp(1.25rem, 2.5vw, 1.48rem); line-height: 1.35; text-wrap: balance; }
  .prose :global(h4) { margin: 1.8em 0 .55em; color: #225b73; font-size: 1.12rem; }
  .prose :global(p), .prose :global(li) { color: #294f62; }
  .prose :global(p) { margin: 1em 0; text-wrap: pretty; }
  .prose :global(li) { margin: .38em 0; }
  .prose :global(strong) { color: #143f57; }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid rgba(184,243,90,.35); }
  .prose :global(code) { padding: .15em .4em; color: var(--accent); background: var(--surface-raised); border-radius: 5px; font-size: .9em; }
  .prose :global(pre) { overflow: auto; padding: 22px; background: #050606; border: 1px solid var(--line); border-radius: 12px; }
  .prose :global(pre code) { padding: 0; color: inherit; background: none; }
  .prose :global(blockquote), .prose :global(aside) { display: block; margin: 2em 0; padding: 16px 20px; color: #355f73; background: rgba(214,243,252,.6); border-left: 3px solid var(--accent); border-radius: 0 12px 12px 0; }
  .prose :global(img) { display: block; width: auto; max-width: 100%; max-height: min(72vh, 760px); margin: 2.2rem auto; object-fit: contain; border: 8px solid rgba(255,255,255,.9); border-radius: 14px; box-shadow: 0 14px 32px rgba(29,87,111,.18); }
  .prose :global(hr) { height: 1px; margin: 2.6rem 0; background: var(--line); border: 0; }
  .prose :global(table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; }
  .prose :global(th), .prose :global(td) { padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
  .prose :global(th) { color: #173f56; background: rgba(207,239,250,.65); }
  @media (max-width: 580px) { header { padding-top: 58px; } .meta { flex-direction: column; } .prose { padding: 24px 20px; border-radius: 17px; } .prose :global(img) { max-height: 68vh; border-width: 5px; } }
</style>
