---
import BaseLayout from '../layouts/BaseLayout.astro';
import FunWords from '../components/FunWords.astro';
import { siteConfig } from '../config/site';
import roomScenes from '../data/room-scenes.json';

const firstScene = roomScenes[0];

const portals = [
  { href: '/blogs', label: '我的日志', note: '把想说的话，慢慢写下来。', icon: '文', detail: '心境与经历' },
  { href: '/blogs?category=notes', label: '技术笔记', note: '收藏技术理解、判断和实践方法。', icon: '记', detail: '技术与实用笔记' },
  { href: '/picture', label: '我的相册', note: '收集好看的画面与小小瞬间。', icon: '画', detail: '随机图片与相框' },
  { href: '/music', label: '音乐盒', note: '给今天留一首背景音乐。', icon: '音', detail: '音乐与声音收藏' },
  { href: '/tools', label: '工具抽屉', note: '需要的时候，就来这里翻翻。', icon: '用', detail: '网络与实用工具' },
  { href: '/link', label: '链接收藏', note: '互联网里值得记下的坐标。', icon: '链', detail: '短链接与坐标' },
];
---

<BaseLayout>
  <div class="home container">
    <header class="space-heading">
      <div>
        <p class="space-kicker"><span aria-hidden="true">✦</span> 欢迎来到我的个人空间 <span aria-hidden="true">✦</span></p>
        <h1><span data-site-name>{siteConfig.siteName}</span></h1>
        <p class="signature">深夜的海边，浪声没停过，但你不觉得吵…</p>
      </div>
      <div class="heading-stamp" aria-hidden="true"><span>私人小窝</span><strong>HOME SWEET HOME</strong><span>奶油色的日常 / 一点点浪漫</span></div>
    </header>

    <nav class="space-tabs" aria-label="空间栏目">
      <a href="/" class="current" aria-current="page">空间首页</a>
      {portals.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="space-columns">
      <aside class="space-sidebar" aria-label="空间主人资料">
        <section class="space-panel profile-panel" aria-labelledby="profile-title">
          <h2 class="panel-heading" id="profile-title"><span aria-hidden="true">☆</span> 关于空间主人 <span class="heading-dots" aria-hidden="true">···</span></h2>
          <div class="profile-body">
            <div class="portrait-frame">
              <span class="portrait-tape" aria-hidden="true"></span>
              <img data-site-avatar src={siteConfig.avatar} width="200" height="200" alt="空间主人的头像" />
              <span class="portrait-caption">MY LITTLE PORTRAIT</span>
            </div>
            <p class="owner-name">Kielasovo <span aria-hidden="true">✧</span></p>
            <p class="owner-motto">我的智商堪比一条边牧</p>
            <dl class="profile-details">
              <div><dt>空间昵称</dt><dd>KIELAS520</dd></div>
              <div><dt>个性标签</dt><dd>Definition → NuLL</dd></div>
              <div><dt>这里收藏</dt><dd>文字 · 图片 · 音乐</dd></div>
            </dl>
          </div>
        </section>

        <section class="space-panel note-panel" aria-labelledby="note-title">
          <h2 class="panel-heading" id="note-title"><span aria-hidden="true">☆</span> 小窝便签</h2>
          <div class="note-body">
            <p class="note-date">TO：路过这里的你</p>
            <p>欢迎来坐坐。<br />窗外下雪，屋里有灯，<br />把喜欢的东西都放在这里。</p>
            <span class="note-signature">慢慢逛，不着急。</span>
          </div>
        </section>

        <section class="space-panel bookmarks-panel" aria-labelledby="bookmark-title">
          <h2 class="panel-heading" id="bookmark-title"><span aria-hidden="true">☆</span> 随手打开</h2>
          <div class="bookmark-links">
            <a href="/blogs">读一篇日志 <span aria-hidden="true">›</span></a>
            <a href="/blogs?category=notes">翻一页技术笔记 <span aria-hidden="true">›</span></a>
            <a href="/music">听一点音乐 <span aria-hidden="true">›</span></a>
            <a href="/link">找一个坐标 <span aria-hidden="true">›</span></a>
          </div>
        </section>
      </aside>

      <div class="space-main">
        <section class="space-panel room-panel" aria-labelledby="room-title" data-room-scenes={JSON.stringify(roomScenes)} data-room-id={firstScene.id}>
          <div class="panel-heading room-heading">
            <h2 id="room-title"><span aria-hidden="true">☆</span> 我的像素小窝</h2>
            <span class="room-weather" data-room-weather>{firstScene.weather}</span>
          </div>
          <figure class="room-figure">
            <div class="room-image-wrap">
              <img data-room-image src={firstScene.src} width="720" height="448" alt={firstScene.alt} fetchpriority="high" />
            </div>
            <figcaption><span><span aria-hidden="true">✦</span> <span data-room-caption>{firstScene.caption}</span></span><span class="room-caption-tag" data-room-name>{firstScene.name}</span></figcaption>
          </figure>
        </section>

        <section class="space-panel portal-panel" aria-labelledby="portal-title">
          <h2 class="panel-heading" id="portal-title"><span aria-hidden="true">☆</span> 空间里的收藏 <span class="heading-dots" aria-hidden="true">···</span></h2>
          <nav class="portal-grid" aria-label="全部内容入口">
            {portals.map((item) => (
              <a class="portal-card" href={item.href}>
                <span class="portal-icon" aria-hidden="true">{item.icon}</span>
                <span class="portal-copy"><strong>{item.label}</strong><span>{item.note}</span><small>{item.detail} <span aria-hidden="true">›</span></small></span>
              </a>
            ))}
            <div class="collection-note"><span aria-hidden="true">✧</span><p>把平凡的日子<br />装进小小的空间里。</p></div>
          </nav>
        </section>

        <section class="space-panel words-panel" aria-labelledby="words-title">
          <h2 class="panel-heading" id="words-title"><span aria-hidden="true">☆</span> 风送来的一句话 <span class="words-label">随机句子</span></h2>
          <FunWords />
        </section>
      </div>
    </div>
    <p class="home-signoff"><span aria-hidden="true">✦</span> 小小空间，认真收藏。 <span aria-hidden="true">✦</span></p>
  </div>
</BaseLayout>

<script>
  interface RoomScene { id: string; src: string; name: string; weather: string; caption: string; alt: string }

  const chooseRoom = async () => {
    const room = document.querySelector<HTMLElement>('[data-room-scenes]');
    if (!room || room.dataset.roomInitialized === 'true') return;
    room.dataset.roomInitialized = 'true';
    const image = room.querySelector<HTMLImageElement>('[data-room-image]');
    if (!image) return;
    const scenes: RoomScene[] = JSON.parse(room.dataset.roomScenes || '[]');
    let previous: string | null = null;
    try { previous = sessionStorage.getItem('last-room-scene'); } catch {}
    const alternatives = scenes.filter((scene) => scene.id !== previous);
    const choices = alternatives.length > 0 ? alternatives : scenes;
    if (choices.length === 0) return;
    const scene = choices[Math.floor(Math.random() * choices.length)];
    const preview = new Image();
    preview.src = scene.src;
    try { await preview.decode(); } catch { return; }
    if (!room.isConnected) return;
    image.src = scene.src;
    image.alt = scene.alt;
    room.dataset.roomId = scene.id;
    const weather = room.querySelector<HTMLElement>('[data-room-weather]');
    const caption = room.querySelector<HTMLElement>('[data-room-caption]');
    const name = room.querySelector<HTMLElement>('[data-room-name]');
    if (weather) weather.textContent = scene.weather;
    if (caption) caption.textContent = scene.caption;
    if (name) name.textContent = scene.name;
    try { sessionStorage.setItem('last-room-scene', scene.id); } catch {}
    room.dataset.roomReady = 'true';
  };

  chooseRoom();
  document.addEventListener('astro:page-load', chooseRoom);
</script>

<style>
  .home { padding-top: 22px; padding-bottom: 12px; }
  .space-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 12px 9px 20px; }
  .space-kicker { margin: 0 0 7px; color: #9b6d7f; font-size: .7rem; letter-spacing: .13em; }
  .space-kicker span { color: #c589a1; }
  h1 { margin: 0; color: #795364; font-size: clamp(1.45rem, 3.6vw, 2.05rem); font-weight: 700; line-height: 1.35; letter-spacing: .035em; text-shadow: 1px 2px #fffaf5; overflow-wrap: anywhere; }
  .signature { margin: 9px 0 0; color: #926f7e; font-size: .77rem; line-height: 1.8; }
  .heading-stamp { flex-shrink: 0; display: grid; gap: 5px; padding: 12px 20px; text-align: center; border: 1px dashed #cf9eb0; background: #fff8ee9c; transform: rotate(3deg); color: #a16f83; font-size: .66rem; }
  .heading-stamp strong { font: 700 .61rem/1.5 Georgia, serif; letter-spacing: .1em; color: #895767; }
  .space-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 7px 9px; margin-bottom: 12px; border: 1px solid #d5acb8; background: linear-gradient(#fff8f2, #f0d7dd); box-shadow: inset 0 1px #fff; }
  .space-tabs a { padding: 5px 16px; color: #7d596a; font-size: .75rem; line-height: 1.6; border: 1px solid transparent; text-decoration: none; }
  .space-tabs a:hover, .space-tabs .current { color: #985674; border-color: #d5a3b6; background: #fff8f4; box-shadow: inset 0 1px #fff, 1px 1px #dbb9c3; }
  .space-columns { display: grid; grid-template-columns: 214px minmax(0, 1fr); gap: 12px; align-items: start; }
  .space-sidebar, .space-main { min-width: 0; display: grid; gap: 12px; }
  .space-panel { min-width: 0; border: 1px solid #d5acb8; background: #fffaf4; box-shadow: 2px 2px 0 #e7ccd0; }
  .panel-heading { display: flex; align-items: center; gap: 7px; min-height: 33px; margin: 0; padding: 7px 11px; border-bottom: 1px solid #ddbdc6; color: #82566c; background: linear-gradient(#fcecef, #f4dfe4); font-size: .75rem; line-height: 1.5; font-weight: 600; }
  .panel-heading > span:first-child, .room-heading h2 > span { color: #b87c97; }
  .heading-dots { margin-left: auto; letter-spacing: 2px; color: #b88b9d; }
  .profile-body { padding: 18px 13px 12px; text-align: center; }
  .portrait-frame { position: relative; width: 160px; max-width: 100%; margin: 0 auto; padding: 7px 7px 0; border: 1px solid #dbc1bd; background: #fffdf7; box-shadow: 2px 3px #e6d4cd; transform: rotate(-2deg); }
  .portrait-frame img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid #eedad7; }
  .portrait-tape { position: absolute; z-index: 1; width: 52px; height: 16px; left: calc(50% - 26px); top: -9px; transform: rotate(4deg); background: #eabac79c; border-inline: 1px dashed #fff6; }
  .portrait-caption { display: block; padding: 7px 0; color: #a28585; font: .48rem/1.2 ui-monospace, monospace; letter-spacing: .12em; }
  .owner-name { margin: 15px 0 4px; color: #84566c; font-weight: 700; font-size: .95rem; }
  .owner-name span { color: #b67c91; }
  .owner-motto { margin: 0 0 15px; color: #a07788; font-size: .68rem; }
  .profile-details { margin: 0; padding-top: 9px; border-top: 1px dashed #e1c6ca; text-align: left; font-size: .64rem; }
  .profile-details div { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 5px; padding: 5px 0; }
  .profile-details dt { color: #ad8895; }
  .profile-details dd { margin: 0; color: #785d68; overflow-wrap: anywhere; }
  .note-body { margin: 10px; padding: 10px 8px 13px; background: repeating-linear-gradient(#fff9e8 0 25px, #eedecb 25px 26px); color: #917766; font-size: .73rem; line-height: 26px; }
  .note-date { margin: 0 0 4px; color: #ad8779; font-size: .61rem; }
  .note-body p:not(.note-date) { margin: 0; }
  .note-signature { display: block; margin-top: 5px; text-align: right; font-size: .66rem; }
  .bookmark-links { display: grid; padding: 5px 10px; }
  .bookmark-links a { display: flex; justify-content: space-between; padding: 8px 2px; font-size: .7rem; color: #94687d; text-decoration: none; }
  .bookmark-links a + a { border-top: 1px dotted #e4ccd0; }
  .bookmark-links a:hover { color: #b54c79; }
  .room-heading { justify-content: space-between; gap: 12px; }
  .room-heading h2 { margin: 0; font: inherit; }
  .room-weather { color: #ac8390; font-size: .6rem; font-weight: 400; }
  .room-figure { margin: 0; padding: 9px; }
  .room-image-wrap { border: 1px solid #d5b4ae; padding: 4px; background: #eddbcf; }
  .room-figure img { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .room-figure figcaption { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 3px 2px; color: #9d7584; font-size: .65rem; line-height: 1.65; }
  .room-caption-tag { flex-shrink: 0; padding: 1px 6px; border: 1px solid #e5cad0; background: #fff1ee; font-size: .57rem; color: #af8792; }
  .portal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 10px; }
  .portal-card { display: flex; align-items: flex-start; gap: 9px; min-width: 0; padding: 12px 9px; color: #865e71; text-decoration: none; border: 1px solid #e2c3cb; background: linear-gradient(135deg, #fffdf7, #faedf0); box-shadow: inset 0 1px #fff; transition: border-color 140ms ease, background 140ms ease; }
  .portal-card:hover { color: #a94d77; border-color: #bf88a0; background: #fff3f5; }
  .portal-icon { display: grid; flex-shrink: 0; width: 25px; height: 28px; place-items: center; border: 1px solid #d0a5b6; color: #a36283; background: linear-gradient(#fff4f5, #e8cbd5); box-shadow: inset 1px 1px #fff; font-size: .78rem; }
  .portal-copy { display: grid; gap: 6px; min-width: 0; }
  .portal-copy strong { font-size: .74rem; line-height: 1.5; }
  .portal-copy > span { color: #a1818e; font-size: .61rem; line-height: 1.7; }
  .portal-copy small { color: #b07f94; font-size: .57rem; line-height: 1.6; }
  .collection-note { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 6px; border: 1px dashed #e2c5cc; color: #b18b98; background: #fcf5ed; }
  .collection-note > span { color: #c596a4; font-size: 1.6rem; }
  .collection-note p { margin: 0; font-size: .68rem; line-height: 1.9; }
  .words-label { margin-left: auto; font-size: .59rem; color: #ad8795; font-weight: 400; }
  .words-panel :global(.fun-words) { margin-top: 0; }
  .words-panel :global(.fun-window) { min-height: 80px; padding: 18px 25px; border: 0; border-radius: 0; background: #fffaf4; box-shadow: none; backdrop-filter: none; -webkit-mask-image: none; mask-image: none; }
  .words-panel :global(.fun-text) { color: #9a6e83; font: 400 .85rem/1.9 Georgia, 'Songti SC', serif; text-shadow: none; }
  .home-signoff { margin: 22px 0 6px; text-align: center; color: #ad8592; font-size: .64rem; letter-spacing: .12em; }
  .space-tabs a:focus-visible, .portal-card:focus-visible, .bookmark-links a:focus-visible { outline: 2px solid #bd6385; outline-offset: 3px; }
  @media (max-width: 900px) {
    .space-columns { grid-template-columns: 190px minmax(0, 1fr); }
    .portal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .space-tabs a { padding-inline: 12px; }
    .heading-stamp { padding: 10px 12px; }
  }
  @media (max-width: 620px) {
    .home { padding-top: 10px; padding-bottom: 100px; }
    .space-heading { padding: 8px 2px 15px; }
    .heading-stamp { display: none; }
    .space-kicker { font-size: .6rem; }
    .space-tabs { gap: 3px; padding: 6px; }
    .space-tabs a { padding: 4px 10px; font-size: .68rem; }
    .space-columns { grid-template-columns: minmax(0, 1fr); }
    .space-sidebar { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 9px; }
    .profile-panel { grid-row: span 2; }
    .profile-body { padding: 15px 9px 10px; }
    .portrait-frame { width: 130px; }
    .profile-details div { grid-template-columns: 1fr; gap: 2px; }
    .note-body { margin: 7px; padding: 7px; font-size: .65rem; }
    .note-date { font-size: .55rem; }
    .panel-heading { font-size: .7rem; padding-inline: 8px; }
    .room-figure { padding: 6px; }
    .room-figure figcaption { flex-wrap: wrap; gap: 5px; font-size: .6rem; }
    .portal-grid { gap: 6px; padding: 8px; }
    .portal-card { padding: 10px 7px; gap: 7px; }
    .portal-copy > span { font-size: .59rem; }
  }
  @media (max-width: 360px) {
    .space-sidebar { grid-template-columns: minmax(0, 1fr); }
    .profile-panel { grid-row: auto; }
    .profile-details div { grid-template-columns: 70px minmax(0, 1fr); }
    .portal-grid { grid-template-columns: minmax(0, 1fr); }
    .room-weather { font-size: .52rem; }
  }
</style>
