---
import BaseLayout from '../../layouts/BaseLayout.astro';
import shortLinks from '../../data/short-links.json';
import intrestLinksData from '../../data/intrest-links.json';

interface IntrestLink {
  name: string;
  target: string;
  description?: string;
}

const intrestLinks = intrestLinksData as IntrestLink[];

const localPath = (short: string) => `/${short
  .replace(/^https?:\/\//, '')
  .replace(/^(?:www\.)?kielasovo\.com\/?/, '')
  .replace(/^\/+|\/+$/g, '')}`;

const hostname = (target: string) => {
  try {
    return new URL(target).hostname.replace(/^www\./, '');
  } catch {
    return target;
  }
};
---

<BaseLayout title="Link" description="Kielasovo 的自定义短链接目录。">
  <header class="container page-head link-head">
    <p class="eyebrow">Shortcut directory</p>
    <h1>Link</h1>
  </header>
  <div class="container section-head">
    <p>01</p><h2>Shortcuts</h2>
  </div>
  <section class="container link-list">
    {shortLinks.map((link, index) => (
      <a class="link-card" href={localPath(link.short)}>
        <span class="index">{String(index + 1).padStart(2, '0')}</span>
        <div><strong>{link.name}</strong><p>{link.description}</p></div>
        <code>{link.short}</code>
        <span class="arrow">↗</span>
      </a>
    ))}
  </section>
  <div class="container section-head interest-head">
    <p>02</p><h2>Interesting links</h2>
  </div>
  <section class="container interest-grid" aria-label="有趣的网站">
    {intrestLinks.map((link) => (
      <a class="interest-card" href={link.target} target="_blank" rel="noreferrer">
        <span class="site">{hostname(link.target)}</span>
        <h3>{link.name}</h3>
        {link.description && <p>{link.description}</p>}
        <span class="visit">VISIT ↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .section-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .section-head p { margin: 0; color: #6b909f; font: .62rem/1 ui-monospace, monospace; }
  .section-head h2 { margin: 0; color: #1d5872; font: 800 .9rem/1 Verdana, sans-serif; letter-spacing: .04em; }
  .link-list { overflow: hidden; background: rgba(255,255,255,.5); border: 1px solid rgba(255,255,255,.85); border-radius: 20px; box-shadow: 0 14px 35px rgba(41,112,142,.12); }
  .link-card { display: grid; grid-template-columns: 42px 1fr auto 25px; align-items: center; gap: 18px; padding: 21px 24px; border-bottom: 1px solid var(--line); transition: background 160ms ease; }
  .link-card:last-child { border-bottom: 0; }
  .link-card:hover { background: rgba(255,255,255,.7); }
  .index { color: #7b9aa8; font: .65rem/1 ui-monospace, monospace; }
  strong { color: #184b64; font-size: 1rem; }
  p { margin: 3px 0 0; color: var(--muted); font-size: .7rem; }
  .link-card code { color: #2c7793; font-size: .68rem; }
  .arrow { color: var(--green-dark); }
  .interest-head { margin-top: 54px; }
  .interest-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding-bottom: 72px; }
  .interest-card { position: relative; min-height: 190px; padding: 26px; overflow: hidden; background: linear-gradient(145deg, rgba(255,255,255,.82), rgba(217,244,250,.62)); border: 1px solid rgba(255,255,255,.92); border-bottom-color: rgba(36,112,142,.25); border-radius: 19px; box-shadow: 0 12px 28px rgba(39,108,137,.1); transition: transform 180ms ease, box-shadow 180ms ease; }
  .interest-card:hover { transform: translateY(-3px); box-shadow: 0 17px 34px rgba(39,108,137,.15); }
  .site { color: #6a8e9d; font: .62rem/1 ui-monospace, monospace; }
  .interest-card h3 { margin: 30px 0 7px; color: #174a63; font-size: 1.25rem; line-height: 1.2; }
  .interest-card p { max-width: 420px; font-size: .78rem; }
  .visit { position: absolute; right: 24px; bottom: 22px; color: var(--green-dark); font: 700 .58rem/1 Verdana, sans-serif; }
  @media (max-width: 650px) { .link-card { grid-template-columns: 30px 1fr 20px; } .link-card code { display: none; } }
  @media (max-width: 650px) { .interest-grid { grid-template-columns: 1fr; } }
</style>
