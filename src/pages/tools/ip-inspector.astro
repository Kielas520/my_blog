---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="IP Inspector" description="查看当前公网 IP 的网络归属与风险特征。">
  <article class="container tool-page">
    <a class="back" href="/tools">← Tools</a>
    <header>
      <p class="eyebrow">Network identity</p>
      <h1>IP Inspector</h1>
      <p>查看当前出口网络的基本信息和常见风险标记。</p>
    </header>

    <section class="inspector" aria-live="polite">
      <div class="score-panel">
        <div class="score-ring" id="score-ring"><strong id="score">--</strong><span>/ 100</span></div>
        <p id="verdict">等待检测</p>
        <button id="inspect-button" type="button">START INSPECTION</button>
      </div>

      <div class="details">
        <dl>
          <div><dt>PUBLIC IP</dt><dd id="ip">—</dd></div>
          <div><dt>LOCATION</dt><dd id="location">—</dd></div>
          <div><dt>NETWORK</dt><dd id="network">—</dd></div>
          <div><dt>TYPE</dt><dd id="network-type">—</dd></div>
        </dl>
        <div class="flags" aria-label="风险检测项">
          <span data-flag="is_datacenter">DATACENTER</span>
          <span data-flag="is_proxy">PROXY</span>
          <span data-flag="is_vpn">VPN</span>
          <span data-flag="is_tor">TOR</span>
          <span data-flag="is_abuser">ABUSE</span>
        </div>
        <p class="status" id="status">点击按钮开始检测。</p>
      </div>
    </section>
    <p class="notice">检测结果来自公开网络数据库，可能存在延迟或漏判，仅供参考。</p>
  </article>
</BaseLayout>

<script>
  interface IpResult {
    ip?: string;
    is_datacenter?: boolean;
    is_proxy?: boolean;
    is_vpn?: boolean;
    is_tor?: boolean;
    is_abuser?: boolean;
    is_mobile?: boolean;
    is_satellite?: boolean;
    company?: { name?: string; type?: string };
    asn?: { asn?: number; org?: string; type?: string };
    location?: { city?: string; state?: string; country?: string; country_code?: string };
  }

  const button = document.querySelector<HTMLButtonElement>('#inspect-button');
  const status = document.querySelector<HTMLElement>('#status');
  const score = document.querySelector<HTMLElement>('#score');
  const scoreRing = document.querySelector<HTMLElement>('#score-ring');
  const verdict = document.querySelector<HTMLElement>('#verdict');

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const inspect = async () => {
    if (!button || !status || !score || !scoreRing || !verdict) return;
    button.disabled = true;
    button.textContent = 'INSPECTING…';
    status.textContent = '正在连接检测节点…';

    try {
      const response = await fetch('https://api.ipapi.is/', { cache: 'no-store' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json() as IpResult;

      const deductions = {
        is_datacenter: 25,
        is_proxy: 30,
        is_vpn: 20,
        is_tor: 35,
        is_abuser: 35,
      } as const;
      const total = Object.entries(deductions).reduce(
        (sum, [key, points]) => sum + (data[key as keyof typeof deductions] ? points : 0),
        0,
      );
      const finalScore = Math.max(0, 100 - total);
      const label = finalScore >= 85 ? '网络特征较干净' : finalScore >= 60 ? '存在部分风险特征' : '风险特征较明显';

      score.textContent = String(finalScore);
      verdict.textContent = label;
      scoreRing.style.setProperty('--score', String(finalScore));
      scoreRing.dataset.level = finalScore >= 85 ? 'good' : finalScore >= 60 ? 'medium' : 'risk';

      const location = [data.location?.city, data.location?.state, data.location?.country_code || data.location?.country]
        .filter(Boolean)
        .join(' · ');
      const network = [data.asn?.asn ? `AS${data.asn.asn}` : '', data.asn?.org || data.company?.name]
        .filter(Boolean)
        .join(' · ');
      const types = [data.is_mobile ? 'MOBILE' : '', data.is_satellite ? 'SATELLITE' : '', data.asn?.type || data.company?.type]
        .filter(Boolean)
        .join(' · ');

      setText('#ip', data.ip || 'Unknown');
      setText('#location', location || 'Unknown');
      setText('#network', network || 'Unknown');
      setText('#network-type', types || 'Unknown');

      document.querySelectorAll<HTMLElement>('[data-flag]').forEach((element) => {
        const key = element.dataset.flag as keyof IpResult;
        const active = Boolean(data[key]);
        element.classList.toggle('active', active);
        element.classList.toggle('clear', !active);
        element.setAttribute('aria-label', `${element.textContent}: ${active ? 'detected' : 'not detected'}`);
      });
      status.textContent = '检测完成。';
    } catch (error) {
      status.textContent = `检测失败：${error instanceof Error ? error.message : '网络不可用'}`;
      verdict.textContent = '暂时无法检测';
    } finally {
      button.disabled = false;
      button.textContent = 'RUN AGAIN';
    }
  };

  button?.addEventListener('click', inspect);
  void inspect();
</script>

<style>
  .tool-page { max-width: 960px; padding-top: 54px; padding-bottom: 76px; }
  .back { color: var(--muted); font-size: .82rem; }
  header { padding: 72px 0 38px; }
  header h1 { margin: 0; color: #143f57; font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1; letter-spacing: -.06em; text-wrap: balance; }
  header > p:last-child { max-width: 620px; margin: 20px 0 0; color: var(--muted); }
  .inspector { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(0, 1.5fr); overflow: hidden; background: rgba(255,255,255,.64); border: 1px solid rgba(255,255,255,.92); border-radius: 24px; box-shadow: 0 18px 42px rgba(36,104,133,.13); }
  .score-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 440px; padding: 34px; background: linear-gradient(155deg, rgba(207,242,252,.86), rgba(238,251,230,.7)); border-right: 1px solid var(--line); }
  .score-ring { --score: 0; display: grid; width: 184px; height: 184px; background: radial-gradient(circle at center, #f7fdff 61%, transparent 62%), conic-gradient(#54a940 calc(var(--score) * 1%), rgba(48,112,139,.13) 0); border-radius: 50%; place-content: center; text-align: center; box-shadow: inset 0 0 0 1px rgba(255,255,255,.8), 0 12px 26px rgba(36,103,130,.12); }
  .score-ring[data-level="medium"] { background: radial-gradient(circle at center, #f7fdff 61%, transparent 62%), conic-gradient(#d49c2d calc(var(--score) * 1%), rgba(48,112,139,.13) 0); }
  .score-ring[data-level="risk"] { background: radial-gradient(circle at center, #f7fdff 61%, transparent 62%), conic-gradient(#cb5d54 calc(var(--score) * 1%), rgba(48,112,139,.13) 0); }
  .score-ring strong { color: #174b63; font-size: 3rem; line-height: 1; }
  .score-ring span { margin-top: 5px; color: #7894a0; font: .62rem/1 ui-monospace, monospace; }
  .score-panel > p { margin: 18px 0 24px; color: #315f72; font-weight: 700; }
  button { padding: 11px 15px; color: white; background: linear-gradient(#4eafd0,#237f9f); border: 1px solid #1f7694; border-radius: 10px; box-shadow: inset 0 1px rgba(255,255,255,.45), 0 5px 12px rgba(32,108,139,.18); font: 700 .62rem/1 Verdana, sans-serif; cursor: pointer; }
  button:disabled { cursor: wait; opacity: .62; }
  .details { padding: 36px; }
  dl { margin: 0; }
  dl div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 20px; padding: 17px 0; border-bottom: 1px solid var(--line); }
  dt { color: #71909d; font: .62rem/1.4 ui-monospace, monospace; }
  dd { margin: 0; overflow-wrap: anywhere; color: #1b5068; font-weight: 700; }
  .flags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 26px; }
  .flags span { padding: 7px 9px; color: #678896; background: rgba(255,255,255,.62); border: 1px solid var(--line); border-radius: 8px; font: 700 .56rem/1 Verdana, sans-serif; }
  .flags span.clear { color: #397c35; background: rgba(222,246,212,.68); border-color: rgba(73,142,59,.26); }
  .flags span.active { color: #a33e36; background: rgba(255,222,217,.72); border-color: rgba(181,70,60,.28); }
  .status { margin: 28px 0 0; color: var(--muted); font-size: .78rem; }
  .notice { margin: 16px 4px 0; color: #668593; font-size: .7rem; }
  @media (max-width: 720px) { .inspector { grid-template-columns: 1fr; } .score-panel { min-height: 350px; border-right: 0; border-bottom: 1px solid var(--line); } .details { padding: 26px 22px; } }
  @media (max-width: 440px) { dl div { grid-template-columns: 1fr; gap: 6px; } }
</style>
