---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="IP Inspector" description="查看当前公网 IP、地理位置与网络归属。">
  <article class="container tool-page">
    <a class="back" href="/tools">← Tools</a>
    <header>
      <p class="eyebrow">Network identity</p>
      <h1>IP Inspector</h1>
      <p>查看当前出口网络的公网 IP、地理位置和网络归属。</p>
    </header>

    <section class="inspector" id="ip-inspector" aria-live="polite">
      <div class="score-panel">
        <div class="score-ring" id="score-ring"><strong id="score">等待</strong><span>公网地址查询</span></div>
        <p id="verdict">等待检测</p>
        <button id="inspect-button" type="button">START INSPECTION</button>
      </div>

      <div class="details">
        <dl>
          <div><dt>PUBLIC IP</dt><dd id="ip">—</dd></div>
          <div><dt>LOCATION</dt><dd id="location">—</dd></div>
          <div><dt>NETWORK</dt><dd id="network">—</dd></div>
          <div><dt>IP VERSION</dt><dd id="network-type">—</dd></div>
        </dl>
        <div class="flags" aria-label="风险检测项">
          <span data-flag="is_datacenter">DATACENTER</span>
          <span data-flag="is_proxy">PROXY</span>
          <span data-flag="is_vpn">VPN</span>
          <span data-flag="is_tor">TOR</span>
          <span data-flag="is_abuser">ABUSE</span>
        </div>
        <p class="status" id="status">点击按钮开始检测。</p>
      </div>
    </section>
    <p class="notice">采用开源多来源查询策略，支持 IPv4/IPv6。查询结果来自当前成功的来源；未提供的归属信息不会猜测，也不生成 VPN、代理等风险评分。</p>
  </article>
</BaseLayout>

<script>
  import ipaddr from 'ipaddr.js';

  // MyIP's validated-provider-chain approach: https://github.com/jason5ng32/MyIP
  // Address parsing and range classification use the MIT-licensed ipaddr.js.
  const sources = [
    { name: 'ipapi.co', url: 'https://ipapi.co/json/', trace: false },
    { name: 'Cloudflare', url: 'https://www.cloudflare.com/cdn-cgi/trace', trace: true },
    { name: 'ipify', url: 'https://api64.ipify.org?format=json', trace: false },
  ];
  const text = (value: unknown): string => typeof value === 'string' ? value.trim() : '';
  const record = (value: unknown): Record<string, unknown> =>
    value !== null && typeof value === 'object' && !Array.isArray(value)
      ? value as Record<string, unknown>
      : {};

  let activeRoot: HTMLElement | null = null;
  let disposeInspection: (() => void) | undefined;

  const cleanupInspector = () => {
    disposeInspection?.();
    disposeInspection = undefined;
    activeRoot = null;
  };

  const initializeInspector = () => {
    const root = document.querySelector<HTMLElement>('#ip-inspector');
    if (root && root === activeRoot) return;
    cleanupInspector();
    if (!root) return;

    const button = root.querySelector<HTMLButtonElement>('#inspect-button');
    const status = root.querySelector<HTMLElement>('#status');
    const score = root.querySelector<HTMLElement>('#score');
    const scoreRing = root.querySelector<HTMLElement>('#score-ring');
    const verdict = root.querySelector<HTMLElement>('#verdict');
    if (!button || !status || !score || !scoreRing || !verdict) return;

    activeRoot = root;
    let disposed = false;
    let request: AbortController | null = null;
    let timeout: ReturnType<typeof setTimeout> | undefined;
    const flags = root.querySelectorAll<HTMLElement>('[data-flag]');
    const setText = (selector: string, value: string) => {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };
    const resetResults = () => {
      score.textContent = '等待';
      scoreRing.style.removeProperty('--score');
      delete scoreRing.dataset.level;
      ['#ip', '#location', '#network', '#network-type'].forEach((selector) => setText(selector, '—'));
      flags.forEach((element) => {
        element.classList.remove('active', 'clear');
        element.setAttribute('aria-label', `${element.textContent}: 未知`);
      });
    };

    const inspect = async () => {
      if (disposed || request) return;
      const controller = new AbortController();
      request = controller;
      let timedOut = false;
      resetResults();
      button.disabled = true;
      button.textContent = 'INSPECTING…';
      verdict.textContent = '正在检测';
      status.textContent = '正在连接检测节点…';
      root.setAttribute('aria-busy', 'true');
      timeout = setTimeout(() => {
        timedOut = true;
        controller.abort();
      }, 15_000);

      try {
        const failures: string[] = [];
        let result: { data: Record<string, unknown>; ip: string; version: string; source: string } | undefined;
        for (const source of sources) {
          if (controller.signal.aborted) throw new Error('请求已取消');
          status.textContent = `正在查询 ${source.name}…`;
          const hop = new AbortController();
          const cancel = () => hop.abort();
          controller.signal.addEventListener('abort', cancel, { once: true });
          const hopTimeout = setTimeout(cancel, 4_000);
          try {
            const response = await fetch(source.url, { cache: 'no-store', signal: hop.signal });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            let data: Record<string, unknown>;
            if (source.trace) {
              const trace = new Map((await response.text()).split('\n').map((line) => {
                const separator = line.indexOf('=');
                return [line.slice(0, separator), line.slice(separator + 1)] as const;
              }));
              data = { ip: trace.get('ip'), country_code: trace.get('loc') };
            } else {
              data = record(await response.json());
            }
            if (hop.signal.aborted) throw new Error('请求超时');
            if (data.error || data.success === false) {
              throw new Error(text(data.reason) || text(data.message) || text(data.error) || '服务返回错误');
            }
            const ip = text(data.ip);
            if (ip.includes('%') || (!ipaddr.IPv4.isValidFourPartDecimal(ip) && !ipaddr.IPv6.isValid(ip))) {
              throw new Error('服务返回无效 IP');
            }
            const address = ipaddr.process(ip);
            if (address.range() !== 'unicast') throw new Error('服务未返回可用的公网 IP');
            result = { data, ip: address.toString(), version: address.kind() === 'ipv6' ? 'IPv6' : 'IPv4', source: source.name };
            break;
          } catch (error) {
            if (controller.signal.aborted) throw error;
            const reason = hop.signal.aborted ? '请求超时' : error instanceof Error ? error.message : '网络不可用';
            failures.push(`${source.name}：${reason}`);
          } finally {
            clearTimeout(hopTimeout);
            controller.signal.removeEventListener('abort', cancel);
          }
        }
        if (disposed) return;
        if (controller.signal.aborted) throw new Error('请求已取消');
        if (!result) throw new Error(`所有查询来源均不可用（${failures.join('；')}）`);
        const { data, ip, version, source } = result;

        score.textContent = '已连接';
        verdict.textContent = `查询完成 · ${source}`;
        const locationText = [text(data.city), text(data.region), text(data.country_name) || text(data.country_code)]
          .filter(Boolean).join(' · ');
        const network = [text(data.asn), text(data.org)].filter(Boolean).join(' · ');
        setText('#ip', ip);
        setText('#location', locationText || '该来源未提供');
        setText('#network', network || '该来源未提供');
        setText('#network-type', version);
        status.textContent = failures.length
          ? `已切换至 ${source} 获取公网 IP；其他来源暂不可用，未提供的归属和风险信息不会猜测。`
          : `查询完成 · ${source}；风险项为未知，不计算评分。`;
      } catch (error) {
        if (disposed) return;
        resetResults();
        score.textContent = '失败';
        status.textContent = timedOut
          ? '检测失败：请求超时，请重试。'
          : `检测失败：${error instanceof Error ? error.message : '网络不可用'}`;
        verdict.textContent = '暂时无法检测';
      } finally {
        clearTimeout(timeout);
        timeout = undefined;
        request = null;
        if (!disposed) {
          root.removeAttribute('aria-busy');
          button.disabled = false;
          button.textContent = 'RUN AGAIN';
        }
      }
    };

    button.addEventListener('click', inspect);
    disposeInspection = () => {
      disposed = true;
      clearTimeout(timeout);
      request?.abort();
      button.removeEventListener('click', inspect);
    };
    void inspect();
  };

  document.addEventListener('astro:before-swap', cleanupInspector);
  document.addEventListener('astro:page-load', initializeInspector);
  window.addEventListener('pagehide', cleanupInspector);
  window.addEventListener('pageshow', initializeInspector);
  initializeInspector();
</script>

<style>
  .tool-page { max-width: 960px; padding-top: 54px; padding-bottom: 76px; }
  .back { color: var(--muted); font-size: .82rem; }
  header { padding: 72px 0 38px; }
  header h1 { margin: 0; color: #143f57; font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1; letter-spacing: -.06em; text-wrap: balance; }
  header > p:last-child { max-width: 620px; margin: 20px 0 0; color: var(--muted); }
  .inspector { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(0, 1.5fr); min-width: 0; overflow: hidden; background: rgba(255,255,255,.64); border: 1px solid rgba(255,255,255,.92); border-radius: 24px; box-shadow: 0 18px 42px rgba(36,104,133,.13); }
  .score-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 440px; padding: 34px; background: linear-gradient(155deg, rgba(207,242,252,.86), rgba(238,251,230,.7)); border-right: 1px solid var(--line); }
  .score-ring { --score: 0; display: grid; width: 184px; height: 184px; background: radial-gradient(circle at center, #f7fdff 61%, transparent 62%), conic-gradient(#54a940 calc(var(--score) * 1%), rgba(48,112,139,.13) 0); border-radius: 50%; place-content: center; text-align: center; box-shadow: inset 0 0 0 1px rgba(255,255,255,.8), 0 12px 26px rgba(36,103,130,.12); }
  .score-ring strong { color: #174b63; font-size: 3rem; line-height: 1; }
  .score-ring span { margin-top: 5px; color: #7894a0; font: .62rem/1 ui-monospace, monospace; }
  .score-panel > p { margin: 18px 0 24px; color: #315f72; font-weight: 700; }
  button { padding: 11px 15px; color: white; background: linear-gradient(#4eafd0,#237f9f); border: 1px solid #1f7694; border-radius: 10px; box-shadow: inset 0 1px rgba(255,255,255,.45), 0 5px 12px rgba(32,108,139,.18); font: 700 .62rem/1 Verdana, sans-serif; cursor: var(--site-cursor); }
  button:disabled { cursor: wait; opacity: .62; }
  .details { min-width: 0; padding: 36px; }
  dl { margin: 0; }
  dl div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 20px; padding: 17px 0; border-bottom: 1px solid var(--line); }
  dt { color: #71909d; font: .62rem/1.4 ui-monospace, monospace; }
  dd { margin: 0; overflow-wrap: anywhere; color: #1b5068; font-weight: 700; }
  .flags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 26px; }
  .flags span { padding: 7px 9px; color: #678896; background: rgba(255,255,255,.62); border: 1px solid var(--line); border-radius: 8px; font: 700 .56rem/1 Verdana, sans-serif; }
  .status { margin: 28px 0 0; color: var(--muted); font-size: .78rem; }
  .notice { margin: 16px 4px 0; color: #668593; font-size: .7rem; }
  @media (max-width: 720px) { .inspector { grid-template-columns: 1fr; } .score-panel { min-height: 350px; border-right: 0; border-bottom: 1px solid var(--line); } .details { padding: 26px 22px; } }
  @media (max-width: 440px) { dl div { grid-template-columns: 1fr; gap: 6px; } }
</style>
