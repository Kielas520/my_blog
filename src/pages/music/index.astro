---
import BaseLayout from '../../layouts/BaseLayout.astro';
import musicData from '../../data/music.json';

interface Track {
  name: string;
  link: string;
}

const tracks = musicData as Track[];
const firstTrack = tracks[0];
---

<BaseLayout title="音乐盒" description="留在旧空间里的旋律与像素小屋。">
  <header class="container page-head music-head">
    <p class="eyebrow">My little music box</p>
    <h1>藏在空间里的旋律</h1>
    <p>打开一首小曲，像以前挂着 QQ 的下午。</p>
  </header>

  <section class="container player-shell">
    <div class="player-display">
      <div class="disc" aria-hidden="true"><span></span></div>
      <div class="now-playing">
        <p>空间背景音乐</p>
        <h2 id="current-track">{firstTrack?.name ?? 'NO TRACK'}</h2>
        {firstTrack ? (
          <p class="player-hint">圣诞小屋的原配乐、少女插画的原声片段，以及四首原创短曲。点击下方歌曲或用音乐盒的上一首、下一首切换；浏览其他页面时继续播放。不自动播放。</p>
        ) : (
          <p class="empty">No music here.</p>
        )}
      </div>
    </div>

    {tracks.length > 0 && (
      <div class="track-list" aria-label="歌曲列表">
        {tracks.map((track, index) => (
          <button
            class:list={['track', { active: index === 0 }]}
            type="button"
            data-track
            data-name={track.name}
            data-link={track.link}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{track.name}</strong>
            <i>播放</i>
          </button>
        ))}
      </div>
    )}
  </section>
  <section class="container memories" aria-labelledby="memories-title">
    <h2 id="memories-title">那年的画面，那年的声音</h2>
    <div class="memory-links">
      <a href="https://eond.com/link/63280" target="_blank" rel="noopener noreferrer"><span>01 / 画师足迹</span><strong>Enakei · 旧站记录 ↗</strong></a>
      <a href="https://www.tumblr.com/pixelscenery" target="_blank" rel="noopener noreferrer"><span>02 / 像素风景</span><strong>Pixel Scenery ↗</strong></a>
      <a href="https://www.tumblr.com/tofupixel/tagged/pixel%20art%20gif" target="_blank" rel="noopener noreferrer"><span>03 / 像素画师</span><strong>Tofu · 动图作品 ↗</strong></a>
      <a href="https://musmus.main.jp/music_img1.html" target="_blank" rel="noopener noreferrer"><span>04 / 那年的声音</span><strong>MusMus · 慢慢听 ↗</strong></a>
    </div>
  </section>
</BaseLayout>

<script>
  const bindMusicPage = () => {
    const currentTrack = document.querySelector<HTMLElement>('#current-track');
    const playerDisplay = document.querySelector<HTMLElement>('.player-display');
    const trackButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-track]'));
    if (!playerDisplay || playerDisplay.dataset.bound === 'true') return;
    playerDisplay.dataset.bound = 'true';

    trackButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('site-music-select', { detail: { index } }));
      });
    });

    window.addEventListener('site-music-state', ((event: CustomEvent<{ index: number; playing: boolean }>) => {
      const { index, playing } = event.detail;
      const activeButton = trackButtons[index];
      if (currentTrack) currentTrack.textContent = activeButton?.dataset.name || 'NO TRACK';
      playerDisplay.classList.toggle('playing', playing);
      trackButtons.forEach((button, buttonIndex) => {
        button.classList.toggle('active', buttonIndex === index);
        const label = button.querySelector('i');
        if (label) label.textContent = buttonIndex === index && playing ? '播放中' : '播放';
      });
    }) as EventListener);
    window.dispatchEvent(new Event('site-music-request-state'));
  };

  document.addEventListener('astro:page-load', bindMusicPage);
  bindMusicPage();
</script>

<style>
  .music-head { padding-bottom: 22px; }
  .player-shell { padding-bottom: 24px; }
  .player-display { display: grid; grid-template-columns: 150px minmax(0,1fr); align-items: center; min-height: 190px; background: #fff9ee; border: 1px solid #caa4ae; border-radius: 5px 5px 0 0; box-shadow: 3px 3px 0 #e5cbd0; }
  .disc { display: grid; width: 110px; aspect-ratio: 1; justify-self: center; background: repeating-radial-gradient(circle,#563c4d 0 2px,#332834 3px 6px,#785b6d 7px 8px); border: 5px solid #f3d9e3; border-radius: 50%; animation: spin 12s linear infinite paused; }
  .player-display.playing .disc { animation-play-state: running; }
  .disc span { width: 30%; aspect-ratio: 1; margin: auto; background: radial-gradient(circle,#fff9ee 0 13%,#cc89a4 14% 45%,#efd3a1 46%); border-radius: 50%; }
  .now-playing { padding: 24px; }
  .now-playing > p:first-child { margin: 0; color: #a3657c; font-size: 11px; letter-spacing: .1em; }
  h2 { margin: 12px 0; overflow-wrap: anywhere; color: #674b59; font-size: 20px; line-height: 1.5; }
  .player-hint { color: #896e79; font-size: 12px; line-height: 1.9; }
  .empty { color: var(--muted); }
  .track-list { overflow: hidden; background: #fffaf5; border: 1px solid #caa4ae; border-top: 0; border-radius: 0 0 5px 5px; box-shadow: 3px 3px 0 #e5cbd0; }
  .track { display: grid; grid-template-columns: 32px minmax(0,1fr) auto; gap: 8px; align-items: center; width: 100%; padding: 14px 18px; color: inherit; background: transparent; border: 0; border-bottom: 1px dashed var(--line); text-align: left; cursor: var(--site-cursor); }
  .track:last-child { border-bottom: 0; }
  .track:hover, .track.active { background: #fae5ed; }
  .track > span { color: #a3657c; font: 11px/1 ui-monospace, monospace; }
  .track strong { color: #674b59; font-size: 12px; overflow-wrap: anywhere; }
  .track i { color: #a34e71; font: 11px/1 Tahoma,sans-serif; font-style: normal; }
  .memories { margin-bottom: 70px; padding: 20px; background: #fff9ee; border: 1px solid #caa4ae; border-radius: 5px; }
  .memory-links { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .memory-links a { display: grid; gap: 9px; padding: 18px; border: 1px dashed #caa4ae; background: #f9e9ed; }
  .memory-links a:hover { background: #f5dbe5; }
  .memory-links span { font-size: 11px; color: #896e79; }
  .memory-links strong { font-size: 15px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .disc { animation: none; } }
  @media (max-width: 580px) { .player-display { grid-template-columns: 1fr; padding-top: 20px; } .now-playing { padding: 20px; } .memory-links { grid-template-columns: 1fr; } }
</style>
